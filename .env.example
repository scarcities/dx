# Copy to .env and fill in your Alpaca PAPER keys (https://app.alpaca.markets -> Paper account -> API Keys).
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_PAPER=True

# Optional. "iex" works on the free plan in real time. "sip" needs a paid data plan
# for bars younger than 15 minutes, so the live bot would see stale bars on a free plan.
ALPACA_DATA_FEED=iex
